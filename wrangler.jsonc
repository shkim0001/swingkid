// Cloudflare 배포 설정 (데모용)
//   웹(src/static)은 Cloudflare 가 직접 내려주고,
//   API 요청(/query, /models, /memory ...)은 Worker 가 내 PC 의 백엔드(Cloudflare Tunnel)로 넘깁니다.
//
// 배포:   npx wrangler deploy --var BACKEND_URL:https://<터널주소>
{
  "name": "swingkid",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./src/static",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    // 터널 주소. 배포할 때 --var 로 덮어씁니다.
    "BACKEND_URL": ""
  }
}
