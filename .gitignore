data/models/

# 장기 기억 저장소(사용자별 판정 기록, 라이브 모드)
memory.sqlite
memory.sqlite-wal
memory.sqlite-shm

# ── 비밀 정보 (절대 올리지 않음) ──
.env
.env.*

# ── 사용자 데이터 · 실행 중 생기는 파일 ──
checkpoints.sqlite
checkpoints.sqlite-*
memory.sqlite
memory.sqlite-*
accounts.sqlite
accounts.sqlite-*

